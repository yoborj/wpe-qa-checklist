#!/bin/bash
# ssh for Claude's fix runs (put first on PATH by lib/claude.mjs): reuses one connection per WP Engine host, so each
# call costs about 1 s instead of about 20 s. Same options as SSH_SHARE in lib/wpe.mjs. rsync -e ssh goes through it too.
self="$(cd "$(dirname "$0")" && pwd)"
next=""
IFS=: read -ra dirs <<< "$PATH"
for d in "${dirs[@]}"; do
  [ "$(cd "$d" 2>/dev/null && pwd)" = "$self" ] && continue
  if [ -x "$d/ssh" ]; then next="$d/ssh"; break; fi
done
exec "${next:-/usr/bin/ssh}" -o ControlMaster=auto -o ControlPath=/tmp/wpeqa-ssh-%C -o ControlPersist=600 -o ServerAliveInterval=30 "$@"
